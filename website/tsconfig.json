{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ESNext"],
    "noEmit": true,
    "strict": false,
    "types": ["node", "@docusaurus/module-type-aliases"],
    "paths": {
      "@site/*": ["./*"]
    },
    "moduleDetection": "auto"
  }
}
